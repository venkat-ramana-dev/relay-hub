# .env.example
# DEFAULT LOCAL DEV ENVIRONMENT VARIABLES
# Copy this file to '.env' to run the application locally.

# Database
POSTGRES_DB=relayhub
POSTGRES_USER=relayhub
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

TZ=UTC

# Admin bootstrap
RELAYHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RELAYHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Spring profile
SPRING_PROFILES_ACTIVE=local